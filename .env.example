# Proxy API (this machine)
PROXY_PORT=4870
# 0.0.0.0 exposes the proxy to the whole LAN — only do that behind a firewall you trust
PROXY_HOST=127.0.0.1
# Optional: require `Authorization: Bearer <key>` on /v1/* routes. Empty = no auth.
PROXY_API_KEY=

# Phone (adb)
PHONE_SERIAL=
PHONE_PORT=8090
PHONE_REMOTE_DIR=/data/local/tmp/sufficit-embed

# Model
MODEL_FILE=Qwen3-Embedding-4B-Q4_K_M.gguf
MODEL_ALIAS=qwen3-embedding:4b

# llama-server tuning (Galaxy A51 / Exynos 9611: 4x A73 + 4x A53, 4GB RAM)
LLAMA_THREADS=6
LLAMA_CTX=2048
LLAMA_BATCH=512
LLAMA_UBATCH=512

HEALTH_TIMEOUT_MS=3000
START_TIMEOUT_MS=60000
